# ClassSight AI Backend Configuration

# Replace both placeholder values in your local .env file.
DATABASE_URL=postgresql://classsight_user:replace_with_a_local_password@localhost:5432/classsight_db
POSTGRES_PASSWORD=replace_with_a_local_password
JWT_SECRET_KEY=replace_with_a_random_secret_at_least_32_bytes
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Environment
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000

# Attendance Ingestion Rules
MIN_ATTENDANCE_DURATION=30.0
MIN_ATTENDANCE_OBSERVATIONS=2
